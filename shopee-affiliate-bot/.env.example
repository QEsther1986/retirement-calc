# ===========================================================
#  機密金鑰設定檔（範本）
# -----------------------------------------------------------
#  使用方式：
#    1. 複製這個檔案、改名成 .env（注意前面有一個點，沒有副檔名）
#       Mac/Linux:  cp .env.example .env
#       Windows:    copy .env.example .env
#    2. 把下面等號右邊換成你自己的金鑰
#
#  ⚠️ 安全提醒
#    * .env 裡面是「等同你帳號密碼」的東西，絕對不要傳給任何人
#    * 這個專案已經設定好不會把 .env 上傳到 GitHub
#    * 沒有要用的服務就整行留空或加 # 註解掉，不會影響程式運作
# ===========================================================


# --- Claude API（產生腳本與文案）---
# 申請：https://console.anthropic.com  -> API Keys -> Create Key
# 不填也能跑，只是會改用內建的樣板文案，品質比較普通。
ANTHROPIC_API_KEY=


# --- 蝦皮聯盟開放 API ---
# 只有 config.yaml 的 source.mode 設成 shopee 時才需要。
# 要在蝦皮聯盟後台申請 Open API 權限才會拿到這兩組值。
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=


# --- Facebook 粉絲專頁 ---
# 取得方式見 docs/04-申請各平台API.md
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# 如果要做多個粉專（矩陣），往下加，並在 config.yaml 對應填上變數名稱：
# FB_PAGE_ID_2=
# FB_PAGE_ACCESS_TOKEN_2=


# --- Instagram 商業帳號 ---
# IG_USER_ID 是一串數字，不是 @帳號名稱
IG_USER_ID=
IG_ACCESS_TOKEN=

# IG_USER_ID_2=
# IG_ACCESS_TOKEN_2=


# --- TikTok ---
# 申請：https://developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# TIKTOK_CLIENT_KEY_2=
# TIKTOK_CLIENT_SECRET_2=
# TIKTOK_REFRESH_TOKEN_2=
